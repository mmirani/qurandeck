# Copy to .env.local. Do not commit real values.

# Required
AUTH_SECRET=
AUTH_URL=http://localhost:3310
DATABASE_URL=

# Email sign-in. Both are required in production and on Vercel.
# Verify the sender domain in Resend before launch. Do not use onboarding@resend.dev publicly.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=QuranDeck <sign-in@example.com>

# Set to true for public signup. Leave unset for invite-only beta.
AUTH_PUBLIC_SIGNUP=

# Invite-only beta (used when AUTH_PUBLIC_SIGNUP is not true)
BETA_INVITE_SECRET=
BETA_ALLOWED_EMAILS=

# Google OAuth. Redirect: https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple. AUTH_APPLE_ID is the Services ID.
# Provide AUTH_APPLE_SECRET, or the three key fields and QuranDeck will sign the client secret.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
